<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Contents/Helpers/{ffmpeg,ffprobe,7zz} in the Mac App Store edition: launched by the app with Process, they run in
	     the app's own sandbox (inherit) and can reach only what the app can. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.inherit</key><true/>
</dict>
</plist>
